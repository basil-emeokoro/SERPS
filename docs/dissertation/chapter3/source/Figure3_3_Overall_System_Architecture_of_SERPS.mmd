flowchart TB
  Actors[Actors and Browsers] --> Frontend[Presentation Layer]
  Frontend --> REST[REST API]
  Frontend --> Realtime[WebSocket / SSE]
  Frontend --> WebRTC[WebRTC Boundary]
  REST --> API[FastAPI Application Services]
  Realtime --> API
  WebRTC --> API
  API --> Camera[Camera Manager]
  API --> Auth[Authentication]
  API --> Candidate[Candidate / Exam]
  API --> Session[Session Control]
  API --> Reports[Reports / Audit]
  Camera --> Detection[Detection Modules]
  Candidate --> EvidenceService[Evidence Service]
  EvidenceService --> Evidence[Structured EvidenceEvent]
  Detection --> Evidence
  Evidence --> CIE[Contextual Intelligence Engine]
  CIE --> Agentic[Agentic Decision Support]
  Agentic --> IPIME
  IPIME --> Reviewer[Human Reviewer]
  Reviewer --> Final[Final Institutional Decision]
  Evidence -. persist .-> DB[(PostgreSQL)]
  Evidence -. snapshots .-> Storage[Evidence Storage]
  Reports -. exports .-> Docs[Documentation / Reports]
