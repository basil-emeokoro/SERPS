%%{init: {'theme': 'base', 'themeVariables': {'primaryColor': '#DDF7F5', 'primaryBorderColor': '#0F8B8D', 'lineColor': '#7FA9B5', 'fontFamily': 'Segoe UI, Arial'}}}%%
classDiagram
  class Institution {+institution_id +name +created_at}
  class StaffUser {+user_id +email +status}
  class Role {+role_id +name}
  class UserRole {+user_id +role_id}
  class Candidate {+candidate_id +institution_reference +email}
  class Examination {+examination_id +title +status}
  class CandidateExaminationAssignment {+assignment_id +status}
  class ExaminationSession {+session_id +status +monitoring_mode}
  class EvidenceEvent {+event_id +event_type +confidence}
  class ContextualAssessment {+risk_score +risk_level +explanation}
  class Recommendation {+action +rationale}
  class PolicyRule {+condition +action}
  class Incident {+policy_response +status}
  class Acknowledgement {+candidate_statement +signed_at}
  class ReviewerAction {+decision +rationale}
  class AuditLog {+action +timestamp}
  Institution "1" -- "0..*" StaffUser
  StaffUser "1" -- "0..*" UserRole
  Role "1" -- "0..*" UserRole
  Institution "1" -- "0..*" Candidate
  Candidate "1" -- "0..*" CandidateExaminationAssignment
  Examination "1" -- "0..*" CandidateExaminationAssignment
  CandidateExaminationAssignment "1" -- "0..*" ExaminationSession
  ExaminationSession "1" -- "0..*" EvidenceEvent
  EvidenceEvent "0..*" -- "0..*" ContextualAssessment
  ContextualAssessment "1" -- "0..*" Recommendation
  PolicyRule "0..*" -- "0..*" Incident
  Incident "1" -- "0..1" Acknowledgement
  Incident "1" -- "0..*" ReviewerAction
  ReviewerAction "1" -- "0..*" AuditLog
