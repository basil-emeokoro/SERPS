    "/api/v1/evidence-events/": {
      "post": {
        "tags": [
          "evidence"
        ],
        "summary": "Create Evidence Event",
        "description": "Accept a structured evidence event.\n\nSprint 1 validates the API contract and domain schema. Repository-backed\npersistence is wired through SQLAlchemy models and will be enabled in the\nnext migration sprint.",
        "operationId": "create_evidence_event_api_v1_evidence_events__post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvidenceEventCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvidenceEvent"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
