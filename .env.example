SERPS_ENV=development
SERPS_API_HOST=0.0.0.0
SERPS_API_PORT=8000
SERPS_DATABASE_URL=postgresql+psycopg://serps:replace-with-url-encoded-password@localhost:5432/serps_pop
SERPS_POSTGRES_PASSWORD=replace-with-a-strong-local-password
SERPS_JWT_SECRET=replace-with-at-least-32-random-characters
SERPS_JWT_ISSUER=serps-pop
SERPS_JWT_AUDIENCE=serps-api
SERPS_ACCESS_TOKEN_MINUTES=10
SERPS_REFRESH_TOKEN_DAYS=7
SERPS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# One-time offline bootstrap only; inject privately and remove after provisioning.
# SERPS_BOOTSTRAP_CONFIRM=fresh-database
# SERPS_BOOTSTRAP_INSTITUTION_CODE=STAGE
# SERPS_BOOTSTRAP_INSTITUTION_NAME=Staging Institution
# SERPS_BOOTSTRAP_EMAIL=operator@example.invalid
# SERPS_BOOTSTRAP_FULL_NAME=Approved Operator
# SERPS_BOOTSTRAP_PASSWORD=replace-with-a-unique-password-at-least-16-characters
# Prototype defence/demo control only. Keep false for normal examination behaviour.
SERPS_DEMO_POLICY_CONTROLS=false
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Railway pre-deploy migrations: set false; Compose defaults to true.
# SERPS_RUN_MIGRATIONS=false
# PORT is provided by the cloud platform.
# SERPS_TRUSTED_PROXY_IPS=127.0.0.1
